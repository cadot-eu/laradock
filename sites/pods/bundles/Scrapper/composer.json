{
    "name": "cadot.eu/scrapper",
    "description": "scrapping par panther avec event",
    "type": "symfony-bundle",
    "license": "MIT",
    "minimum-stability": "stable",
    "authors": [
        { "name": "cadot.eu" }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/routing": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher-contracts": "^2.5|^3.0",
        "sapistudio/seleniumstealth": "^1.0"
    },
    "autoload": {
        "psr-4": { "CadotEu\\Scrapper\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "CadotEu\\Scrapper\\Tests\\": "tests/" }
    },
    "keywords": ["symfony", "bundle"],
    "require-dev": {
        "symfony/panther": "^2.4",
        "symfony/phpunit-bridge": "^8.1",
        "dbrekelmans/bdi": "^1.4"
    }
}
